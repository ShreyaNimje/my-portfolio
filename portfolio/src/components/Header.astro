---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/my-portfolio/">Home</HeaderLink>
			<HeaderLink href="/my-portfolio/blog">Projects</HeaderLink>
			<HeaderLink href="/my-portfolio/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: transparent;
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
		font-weight: 700;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--accent-dark));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.5em 0;
	}
	nav a {
		padding: 0.5em 1em;
		color: rgb(var(--gray-dark));
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-weight: 500;
		transition: all 0.2s ease;
	}
	nav a:hover {
		color: rgb(var(--accent));
	}
	nav a.active {
		text-decoration: none;
		color: rgb(var(--accent-dark));
		border-bottom-color: rgb(var(--accent));
	}
	.internal-links {
		display: flex;
		gap: 0.5em;
	}
</style>