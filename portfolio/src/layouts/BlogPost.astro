---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, githubLink } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}

			.hero-image {
				width: 100%;
				max-width: 1020px;
				margin: 0 auto;
				padding: 0 1em;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 16px;
				box-shadow: var(--box-shadow);
				border: 1px solid rgba(var(--accent), 0.15);
			}

			.prose {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}

			/* --- TITLE / META BLOCK --- */
			.title {
				margin-bottom: 1.5em;
				padding: 2em 0 1.5em;
				text-align: center;
				line-height: 1;
			}

			.title .badge-top {
				margin: 0 auto 1em;
			}

			.title h1 {
				margin: 0 0 0.4em 0;
				font-size: 2.6rem;
				line-height: 1.15;
				background-image: linear-gradient(45deg, rgb(var(--accent-dark)), rgb(var(--accent)));
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				color: transparent;
			}

			.date {
				margin-bottom: 1em;
				color: rgb(var(--gray));
				font-size: 0.95rem;
				font-weight: 500;
			}

			.last-updated-on {
				font-style: italic;
			}

			/* --- GITHUB CTA BUTTON --- */
			.github-cta {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				margin: 0 0 1.5em;
				padding: 0.7rem 1.4rem;
				border-radius: 8px;
				font-weight: 700;
				font-size: 0.95rem;
				text-decoration: none !important;
				color: white !important;
				background: linear-gradient(45deg, rgb(var(--accent-dark)), rgb(var(--accent)));
				box-shadow: 0 4px 12px rgba(var(--accent-dark), 0.3);
				transition: all 0.2s ease;
				border-bottom: none !important;
			}

			.github-cta:hover {
				transform: translateY(-2px);
				box-shadow: 0 6px 16px rgba(var(--accent-dark), 0.4);
			}

			.github-cta svg {
				width: 18px;
				height: 18px;
				flex-shrink: 0;
			}

			.title hr {
				border: none;
				border-top: 1px solid rgba(var(--accent), 0.2);
				max-width: 200px;
				margin: 1.5em auto 0;
			}

			/* --- MARKDOWN CONTENT THEMING --- */
			.prose :global(h2) {
				margin-top: 1.8em;
				color: rgb(var(--black));
				font-size: 1.6rem;
			}

			.prose :global(h3) {
				margin-top: 1.5em;
				color: rgb(var(--accent-dark));
				font-size: 1.25rem;
			}

			.prose :global(p) {
				line-height: 1.8;
			}

			.prose :global(ul),
			.prose :global(ol) {
				padding-left: 1.4em;
				line-height: 1.8;
			}

			.prose :global(li strong) {
				color: rgb(var(--accent-dark));
			}

			.prose :global(a) {
				color: rgb(var(--accent-dark));
				text-decoration: underline;
				text-decoration-color: rgba(var(--accent), 0.4);
				text-underline-offset: 3px;
			}

			.prose :global(a:hover) {
				text-decoration-color: rgb(var(--accent-dark));
			}

			.prose :global(blockquote) {
				border-left: 4px solid rgb(var(--accent));
				background: rgba(var(--accent), 0.06);
				border-radius: 0 8px 8px 0;
				padding: 0.8em 1.2em;
				margin: 1.5em 0;
			}

			.prose :global(code) {
				color: rgb(var(--accent-dark));
				background-color: rgba(var(--accent), 0.1);
			}

			.prose :global(pre) {
				background-color: rgb(var(--black));
				box-shadow: var(--box-shadow);
			}

			.prose :global(pre) :global(code) {
				color: inherit;
				background: none;
			}

			/* --- TECH STACK TABLE THEMING --- */
			.prose :global(table) {
				width: 100%;
				border-collapse: collapse;
				margin: 1.5em 0;
				border-radius: 12px;
				overflow: hidden;
				box-shadow: 0 4px 10px -4px rgba(0,0,0,0.08);
			}

			.prose :global(th) {
				background: linear-gradient(45deg, rgb(var(--accent-dark)), rgb(var(--accent)));
				color: white;
				text-align: left;
				padding: 0.7em 1em;
				font-weight: 700;
			}

			.prose :global(td) {
				padding: 0.7em 1em;
				border-bottom: 1px solid rgba(var(--accent), 0.12);
				background-color: rgba(255, 255, 255, 0.6);
			}

			.prose :global(tr:last-child td) {
				border-bottom: none;
			}

			@media (max-width: 720px) {
				.title h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							githubLink && (
								<a
									class="github-cta"
									href={githubLink}
									target="_blank"
									rel="noopener noreferrer"
								>
									<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
										<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
										0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01
										1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95
										0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68
										0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82
										2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2
										0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
									</svg>
									View Code on GitHub
								</a>
							)
						}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
