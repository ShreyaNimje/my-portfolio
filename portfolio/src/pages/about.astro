---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = `About | ${SITE_TITLE}`;
const pageDescription = 'Learn more about Shreya Nimje — AI/ML Software Engineer and Full-Stack Developer.';

const techStack = [
	{
		label: 'Frontend',
		icon: '🎨',
		items: ['HTML5 / CSS3', 'JavaScript', 'React', 'Astro', 'Tailwind CSS'],
	},
	{
		label: 'Backend',
		icon: '⚙️',
		items: ['Node.js / Express', 'PHP', 'Python', 'REST APIs'],
	},
	{
		label: 'Data & ML',
		icon: '📊',
		items: ['Scikit-Learn', 'Pandas / NumPy', 'Plotly', 'Jupyter'],
	},
	{
		label: 'Databases',
		icon: '🗄️',
		items: ['MySQL', 'MongoDB'],
	},
	{
		label: 'Tools',
		icon: '🛠️',
		items: ['Git / GitHub', 'VS Code', 'Postman', 'Figma'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="about-page">
			<!-- INTRO SECTION -->
			<section class="about-hero">
				<div class="about-image-wrapper">
					<div class="image-card-container">
						<img
							src="/my-portfolio/profile.jpeg"
							alt="Shreya Nimje"
							class="profile-img about-profile-img"
							onerror="this.onerror=null; this.src='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22500%22%3E%3Crect width=%22100%25%22 height=%22100%25%22 fill=%22%23fdf2e2%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 font-family=%22sans-serif%22 font-size=%2222%22 fill=%22%23d97706%22%3EAdd profile.jpg%3C/text%3E%3C/svg%3E';"
						/>
					</div>
				</div>

				<div class="about-content">
					<div class="badge-top">
						<span class="dot"></span> About Me
					</div>

					<h1 class="hero-title about-title">
						Hi, I'm <span class="gradient-text">Shreya</span> 👋
					</h1>

					<h2 class="hero-subtitle">
						AI & ML Software Engineer • Full Stack Developer
					</h2>

					<p class="hero-description about-summary">
						I'm an MCA student specializing in Artificial Intelligence and Machine Learning, with hands-on
						experience across full-stack web development and data-driven engineering. I enjoy turning messy,
						real-world data into clear insight, and turning ideas into fast, reliable, well-designed products —
						from data pipelines and ML models to responsive, production-ready web applications.
					</p>

					<p class="hero-description about-summary">
						Whether I'm building a REST API, training a model, or polishing a UI, I care about writing code
						that's clean, scalable, and easy for the next person (often future-me) to pick up.
					</p>

					<div class="hero-actions">
						<a href="/my-portfolio/SHREYA_NIMJE_Resume.pdf" class="btn btn-primary" target="_blank" rel="noopener noreferrer">👀 View Resume</a>
						<a href="/my-portfolio/blog" class="btn btn-outline">View Projects</a>
					</div>
				</div>
			</section>

			<!-- SCROLL-TRIGGERED TECH STACK TIMELINE -->
			<section class="stack-section">
				<h3 class="stack-heading">My Tech Stack</h3>

				<div class="stack-timeline-wrapper">
					<div class="stack-progress-track" aria-hidden="true">
						<div class="stack-progress-fill" id="stackProgressFill"></div>
					</div>

					<div class="stack-timeline">
						{techStack.map((group) => (
							<div class="stack-item" data-stack-item>
								<div class="stack-dot"></div>
								<div class="stack-card">
									<h4><span class="stack-icon">{group.icon}</span> {group.label}</h4>
									<ul>
										{group.items.map((item) => <li>{item}</li>)}
									</ul>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const items = document.querySelectorAll('[data-stack-item]');
			const progressFill = document.getElementById('stackProgressFill');

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('in-view');
						}
					});
				},
				{
					threshold: 0.35,
					rootMargin: '0px 0px -10% 0px',
				}
			);

			items.forEach((item) => observer.observe(item));

			// Fill the connecting line progressively as the user scrolls past items
			function updateProgress() {
				if (!progressFill || items.length === 0) return;
				const wrapper = document.querySelector('.stack-timeline-wrapper');
				if (!wrapper) return;

				const rect = wrapper.getBoundingClientRect();
				const viewportMid = window.innerHeight * 0.65;
				const total = rect.height;
				const scrolled = Math.min(Math.max(viewportMid - rect.top, 0), total);
				const percent = total > 0 ? (scrolled / total) * 100 : 0;

				progressFill.style.height = `${percent}%`;
			}

			window.addEventListener('scroll', updateProgress, { passive: true });
			window.addEventListener('resize', updateProgress);
			updateProgress();
		</script>

		<style>
			.about-page {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 2rem 6rem;
			}

			/* --- INTRO SECTION (mirrors homepage hero) --- */
			.about-hero {
				display: flex;
				align-items: center;
				gap: 4rem;
				margin: 2rem 0 5rem;
			}

			.about-image-wrapper {
				flex: 0.8;
			}

			.about-profile-img {
				aspect-ratio: 4/5;
			}

			.about-content {
				flex: 1.2;
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
				align-items: flex-start;
			}

			.about-title {
				font-size: 3rem;
			}

			.about-summary {
				max-width: 100%;
			}

			/* --- TECH STACK SCROLL TIMELINE --- */
			.stack-section {
				margin-top: 3rem;
			}

			.stack-heading {
				font-size: 2rem;
				text-align: center;
				margin-bottom: 3rem;
				background-image: linear-gradient(45deg, rgb(var(--accent-dark)), rgb(var(--accent)));
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				color: transparent;
			}

			.stack-timeline-wrapper {
				position: relative;
				max-width: 700px;
				margin: 0 auto;
			}

			/* Static background track, left-anchored */
			.stack-progress-track {
				position: absolute;
				left: 7px;
				top: 8px;
				bottom: 8px;
				width: 3px;
				background: rgba(var(--accent), 0.15);
				border-radius: 3px;
			}

			/* Fill that grows as the user scrolls */
			.stack-progress-fill {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 0%;
				background: linear-gradient(180deg, rgb(var(--accent-dark)), rgb(var(--accent)));
				border-radius: 3px;
				transition: height 0.1s linear;
			}

			.stack-timeline {
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}

			.stack-item {
				position: relative;
				padding-left: 2.75rem;
				opacity: 0;
				transform: translateX(-24px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}

			.stack-item.in-view {
				opacity: 1;
				transform: translateX(0);
			}

			.stack-dot {
				position: absolute;
				left: 0;
				top: 6px;
				width: 17px;
				height: 17px;
				border-radius: 50%;
				background: white;
				border: 3px solid rgba(var(--accent), 0.4);
				transition: background 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
				z-index: 1;
			}

			.stack-item.in-view .stack-dot {
				background: linear-gradient(45deg, rgb(var(--accent-dark)), rgb(var(--accent)));
				border-color: rgb(var(--accent));
				box-shadow: 0 0 0 4px rgba(var(--accent), 0.15);
			}

			.stack-card {
				background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.55));
				backdrop-filter: blur(10px);
				border: 1px solid rgba(var(--accent), 0.15);
				border-radius: 18px;
				padding: 1.3rem 1.6rem;
				box-shadow: 0 6px 14px -6px rgba(0,0,0,0.06);
				transition: border-color 0.4s ease, box-shadow 0.4s ease;
			}

			.stack-item.in-view .stack-card {
				border-color: rgba(var(--accent), 0.4);
				box-shadow: var(--box-shadow);
			}

			.stack-card h4 {
				margin: 0 0 0.6rem 0;
				font-size: 1.05rem;
				color: rgb(var(--black));
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.stack-icon {
				font-size: 1.1rem;
			}

			.stack-card ul {
				margin: 0;
				padding: 0;
				list-style: none;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.stack-card li {
				font-size: 0.85rem;
				color: rgb(var(--gray-dark));
				background-color: #ffffff;
				border: 1px solid rgba(0,0,0,0.05);
				border-radius: 8px;
				padding: 0.3rem 0.7rem;
			}

			/* --- MOBILE RESPONSIVENESS --- */
			@media (max-width: 900px) {
				.about-hero {
					flex-direction: column-reverse;
					text-align: center;
					gap: 2.5rem;
					margin: 1.5rem 0 4rem;
				}
				.about-content {
					align-items: center;
				}
				.about-image-wrapper {
					max-width: 280px;
				}
				.stack-timeline-wrapper {
					max-width: 100%;
				}
			}
		</style>
	</body>
</html>
