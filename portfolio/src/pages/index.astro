---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="hero-section">
			<!-- LEFT COLUMN: Text & Buttons -->
			<div class="hero-content">
				<div class="badge-top">
					<span class="dot"></span> MCA Candidate @ RBU • CGPA 8.59
				</div>
				
				<h1 class="hero-title">
					Hi, I'm <br/>
					<span class="gradient-text">Shreya Nimje</span>
				</h1>
				
				<h2 class="hero-subtitle">
					AI & ML Software Engineer • Full Stack Developer
				</h2>
				
				<p class="hero-description">
					Building intelligent, data-driven products and scalable web architectures. Passionate about translating complex datasets into actionable insights and engineering high-performance systems.
				</p>
				
				<div class="tech-tags">
					<span class="tag">📊 Data Analytics</span>
					<span class="tag">⚙️ Python & ML</span>
					<span class="tag">💻 Full Stack Web</span>
				</div>
				
				<div class="hero-actions">
					<a href="/my-portfolio/SHREYA_NIMJE_Resume.pdf" class="btn btn-primary" target="_blank" rel="noopener noreferrer">👀 View Resume</a>
					<a href="/my-portfolio/SHREYA_NIMJE_Resume.pdf" class="btn btn-ghost" download="SHREYA_NIMJE_Resume.pdf">⬇ Download</a>
					<a href="/my-portfolio/blog" class="btn btn-outline">View Projects</a>
				</div>
			</div>

			<!-- RIGHT COLUMN: Education Roadmap -->
			<div class="hero-image-wrapper">
				<div class="roadmap-card">
					<div class="roadmap-header">
						<h3>🎓 Education</h3>
					</div>
					<div class="timeline">
						<div class="timeline-item">
							<div class="dot"></div>
							<h4>MCA - AI/ML Specialization</h4>
							<p>RBU, Nagpur • 8.59 CGPA</p>
						</div>
						<div class="timeline-item">
							<div class="dot"></div>
							<h4>BCCA</h4>
							<p>L.A.D College • 8.09 CGPA</p>
						</div>
						<div class="timeline-item">
							<div class="dot"></div>
							<h4>HSC (PCM)</h4>
							<p>Modern School Nagpur • 2022 • 66%</p>
						</div>
						<div class="timeline-item">
							<div class="dot"></div>
							<h4>SSC</h4>
							<p>B.K.V.V Nagpur • 2020 • 82.4%</p>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>