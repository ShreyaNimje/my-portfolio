---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { Image } from 'astro:assets';

// Fetches your markdown files and sorts them by date
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="projects-section">
				<div class="section-header">
					<h2>My <span class="gradient-text">Projects</span></h2>
					<p>A showcase of my recent work, web apps, and data pipelines.</p>
				</div>
				
				<ul class="glass-grid">
					{
						posts.map((post) => (
							<li>
								<!-- Automatically links to the correct subfolder path -->
								<a href={`/my-portfolio/blog/${post.id}/`} class="project-card">
									
									<!-- Smart Fallback Image -->
									{
										post.data.heroImage ? (
											<Image 
												src={post.data.heroImage} 
												alt={post.data.title} 
												class="project-image"
											/>
										) : (
											<img 
												src="/my-portfolio/blog-placeholder-about.jpg" 
												alt={post.data.title} 
												class="project-image"
											/>
										)
									}
									
									<!-- Hover Reveal Overlay -->
									<div class="glass-overlay">
										<h4 class="project-title">{post.data.title}</h4>
										<p class="project-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<p class="project-desc">{post.data.description}</p>
										<span class="view-btn">View Details ➔</span>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.projects-section {
		max-width: 1100px;
		margin: 4rem auto;
		padding: 0 2rem;
	}
	
	.section-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}
	
	.section-header h2 {
		font-size: 3.5rem;
		margin-bottom: 0.5rem;
		color: rgb(var(--black));
	}
	
	.section-header p {
		color: rgb(var(--gray-dark));
		font-size: 1.2rem;
	}
	
	/* The Grid */
	ul.glass-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2.5rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}

	/* Individual Project Card */
	.project-card {
		display: block;
		position: relative;
		border-radius: 20px;
		overflow: hidden;
		aspect-ratio: 4/3;
		box-shadow: var(--box-shadow);
		border-bottom: none !important; /* Overrides the dashed link style */
		background: linear-gradient(45deg, rgb(var(--accent-dark)), rgb(var(--accent)));
	}

	.project-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	/* 🪟 THE FROSTED GLASS OVERLAY */
	.glass-overlay {
		position: absolute;
		inset: 0;
		/* Semi-transparent white to create the glass effect */
		background: rgba(255, 255, 255, 0.45);
		/* The actual blur effect! */
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.6);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 2rem;
		
		/* Hidden by default */
		opacity: 0;
		transition: all 0.4s ease;
		box-sizing: border-box;
	}

	/* What happens when you hover over the card */
	.project-card:hover .glass-overlay {
		opacity: 1;
	}
	
	.project-card:hover .project-image {
		transform: scale(1.1); /* Slow zoom on the background image */
	}

	/* Animating the text elements */
	.project-title {
		margin: 0 0 0.5rem 0;
		font-size: 1.6rem;
		color: rgb(var(--black));
		transform: translateY(20px);
		transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.project-date {
		margin: 0 0 1rem 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: rgb(var(--accent-dark));
		transform: translateY(20px);
		transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.05s;
	}

	.project-desc {
		margin: 0;
		font-size: 1rem;
		color: rgb(var(--gray-dark));
		line-height: 1.5;
		transform: translateY(20px);
		transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.1s;
	}
	
	.view-btn {
		margin-top: 1.5rem;
		display: inline-block;
		font-size: 0.95rem;
		font-weight: 800;
		color: rgb(var(--accent-dark));
		border-bottom: 2px dashed rgb(var(--accent-dark));
		transform: translateY(20px);
		transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.15s;
	}

	/* Trigger the upward slide animation on hover */
	.project-card:hover .project-title,
	.project-card:hover .project-date,
	.project-card:hover .project-desc,
	.project-card:hover .view-btn {
		transform: translateY(0);
	}

	/* Mobile fallback: Always show a small overlay so mobile users know they can click */
	@media (max-width: 720px) {
		.glass-overlay {
			background: linear-gradient(to top, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0) 100%);
			opacity: 1;
			justify-content: flex-end;
			padding-bottom: 1.5rem;
			backdrop-filter: blur(4px);
		}
		.project-title, .project-date, .project-desc, .view-btn {
			transform: translateY(0);
		}
		.project-desc {
			display: none; /* Hide the long description on tiny screens */
		}
		.view-btn {
			margin-top: 0.5rem;
		}
	}
</style>